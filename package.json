{
	"name": "smart-fake-form-fill",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"description": "A Chrome extension for populating forms with relevant, AI-generated data",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"generate-icons": "./utilities/generate-icons.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/caleb531/smart-fake-form-fill.git"
	},
	"author": "Caleb Evans",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/caleb531/smart-fake-form-fill/issues"
	},
	"homepage": "https://github.com/caleb531/smart-fake-form-fill#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/chrome": "^0.3.7",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"sass-embedded": "^1.108.2",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vite-plugin-web-extension": "^4.5.1"
	},
	"dependencies": {
		"es-toolkit": "^1.53.2",
		"openai": "^7.60.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.0.0",
			"onFail": "ignore"
		}
	}
}
